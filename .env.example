# Runtime
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=mysteryverse
MYSQL_USER=mysteryverse
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DSN=
MYSQL_TLS_MODE=preferred
MYSQL_MAX_OPEN_CONNS=20
MYSQL_MAX_IDLE_CONNS=10
MYSQL_CONN_MAX_LIFETIME=30m
MYSQL_CONN_MAX_IDLE_TIME=5m
MYSQL_PING_TIMEOUT=3s

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=
REDIS_DB=0
REDIS_TLS_ENABLED=false
REDIS_TLS_INSECURE=false
REDIS_POOL_SIZE=10
REDIS_DIAL_TIMEOUT=3s
REDIS_IO_TIMEOUT=3s
REDIS_PING_TIMEOUT=2s

# Go services
GO_ENV=development
GO_LOG_LEVEL=info
GO_API_ADDR=:8080
GO_REALTIME_RUNTIME_ADDR=:8081
GO_WORKER_INTERVAL=5s

# Authentication and room policy
AUTH_IDENTITY_HMAC_KEY=dev-only-change-me-identity-hmac-key
AUTH_SESSION_COOKIE_NAME=mv_session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL=24h
AUTH_REMEMBER_SESSION_TTL=720h
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AUTH_REGISTER_RATE_LIMIT=5
AUTH_REGISTER_RATE_WINDOW=1h
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW=5m
AUTH_CHAT_RATE_LIMIT=10
AUTH_CHAT_RATE_WINDOW=1m
AUTH_CHAT_MAX_LENGTH=4000
AUTH_ROOM_WAITING_TTL=2h
DATA_SECRET_KEY=dev-only-change-me-data-secret-encryption-key
DATA_SECRET_KEY_ID=local-v1

# Python AI service
AI_ENVIRONMENT=development
AI_LOG_LEVEL=INFO
AI_HOST=127.0.0.1
AI_PORT=8000
AI_DATABASE_URL=
AI_REDIS_URL=redis://:change-me-redis-password@127.0.0.1:6379/0
AI_MODEL_PROVIDER=mock
AI_MODEL_NAME=mock-v1
AI_MODEL_BASE_URL=https://api.openai.com/v1
AI_MODEL_API_KEY=
AI_MODEL_TIMEOUT_MS=10000
AI_MODEL_MAX_RETRIES=2
AI_MODEL_RETRY_BACKOFF_MS=100
AI_AGENT_DEFAULT_TIMEOUT_MS=15000
AI_AGENT_DEFAULT_MAX_STEPS=6
AI_AGENT_DEFAULT_CONTEXT_TOKENS=4000
AI_AGENT_RUN_TTL_SECONDS=86400
AI_INTERNAL_SERVICE_ID=go-core
AI_INTERNAL_SERVICE_TOKEN=change-me-ai-internal-token
AI_INTERNAL_SIGNING_KEY_ID=dev-go-core-v1
AI_INTERNAL_REQUEST_SIGNING_KEY=
AI_INTERNAL_REQUEST_SIGNING_PREVIOUS_KEY_ID=
AI_INTERNAL_REQUEST_SIGNING_PREVIOUS_KEY=
AI_INTERNAL_REVOKED_KEY_IDS=
AI_INTERNAL_SIGNATURE_WINDOW_SECONDS=300
AI_INTERNAL_REQUIRED_AGENT_RUN_SCOPE=ai:agent:run
AI_INTERNAL_NONCE_BACKEND=memory
AI_INTERNAL_NONCE_KEY_PREFIX=mv:internal:nonce
AI_INTERNAL_NONCE_STORE_TIMEOUT_SECONDS=1
AI_INTERNAL_KMS_PROVIDER=environment
AI_INTERNAL_KMS_URI=
AI_INTERNAL_MTLS_ENABLED=false
AI_INTERNAL_TLS_CERT_FILE=
AI_INTERNAL_TLS_KEY_FILE=
AI_INTERNAL_TLS_CA_FILE=
AI_INTERNAL_TLS_REQUIRE_CLIENT_CERT=true
AI_ALLOW_RESTRICTED_MODEL_CONTEXT=false
AI_LOG_PAYLOADS=false

# Web
VITE_APP_NAME=MysteryVerse
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
